# Copie para .env (Compose) ou apps/web/.env.local (desenvolvimento). Nunca commite valores reais.
APP_URL=http://localhost:3000
AUTH_SECRET=
# Conexões por papel (ver docs/DECISOES.md ADR-004)
DATABASE_URL=postgres://gct_app:SENHA@localhost:5432/gct_dev
AUTH_DATABASE_URL=postgres://gct_auth:SENHA@localhost:5432/gct_dev
PLATFORM_DATABASE_URL=postgres://gct_platform:SENHA@localhost:5432/gct_dev
PUBLIC_DATABASE_URL=postgres://gct_public:SENHA@localhost:5432/gct_dev
MIGRATION_DATABASE_URL=postgres://gct_owner:SENHA@localhost:5432/gct_dev
DB_POOL_MAX=10
STORAGE_PATH=./storage
# E-mail desligado quando vazio (smtp://usuario:senha@host:587 ou smtps://...:465)
SMTP_URL=
SMTP_FROM=
# Cobrança da assinatura do SaaS: manual até escolher gateway
BILLING_PROVIDER=manual
BILLING_WEBHOOK_SECRET=
# sandbox | production — eventos de outro ambiente são recusados
BILLING_ENVIRONMENT=sandbox
# Administração da plataforma exige 2FA (desligar só em desenvolvimento)
PLATFORM_REQUIRE_2FA=true
