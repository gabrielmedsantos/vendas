# Modelo do .env.production da VPS. Criar NO SERVIDOR com `chmod 600`; nunca commitar.
# Gerar valores no servidor, ex.: openssl rand -hex 32   (use hex: senhas entram em URLs)
APP_VERSION=local
APP_URL=https://seu-dominio.exemplo
APP_DOMAIN=seu-dominio.exemplo
WEB_PORT=3000
DB_NAME=gct
POSTGRES_PASSWORD=
GCT_OWNER_PASSWORD=
GCT_APP_PASSWORD=
GCT_AUTH_PASSWORD=
GCT_PLATFORM_PASSWORD=
GCT_PUBLIC_PASSWORD=
AUTH_SECRET=
DB_POOL_MAX=10
# E-mail desligado enquanto vazio
SMTP_URL=
SMTP_FROM=
REQUIRE_EMAIL_VERIFICATION=true
# Cobrança manual no piloto; webhook desligado enquanto o segredo estiver vazio
BILLING_PROVIDER=manual
BILLING_WEBHOOK_SECRET=
BILLING_ENVIRONMENT=production
PLATFORM_REQUIRE_2FA=true
